+"""Validate the installable custom integration through Home Assistant's loader."""
+
+import os
+from pathlib import Path
+from shutil import copytree
+from unittest.mock import patch
+
+import pytest
+
+from homeassistant.core import HomeAssistant
+from homeassistant.loader import async_get_integration
+from homeassistant.setup import async_setup_component
+
+from .conftest import mock_make_request, mock_post_request
+
+
+@pytest.mark.usefixtures("enable_custom_integrations")
+async def test_custom_focusprowifi(
+    hass: HomeAssistant, config: dict[str, str], tmp_path: Path
+) -> None:
+    """Load the shipped component and exercise mode and temperature actions."""
+    source = (
+        Path(
+            os.environ.get(
+                "EVOHOME_PACKAGE_ROOT", "/workspace/evohome-focusprowifi-2026.10.0"
+            )
+        )
+        / "custom_components/evohome"
+    )
+    hass.config.config_dir = str(tmp_path)
+    await hass.async_add_executor_job(
+        copytree, source, hass.config.path("custom_components/evohome")
+    )
+    with (
+        patch(
+            "evohomeasync2.auth.CredentialsManagerBase._post_request",
+            mock_post_request("focusprowifi"),
+        ),
+        patch(
+            "_evohome.auth.AbstractAuth._make_request",
+            mock_make_request("focusprowifi"),
+        ),
+        patch("evohomeasync2.zone.Zone.get_schedule") as get_schedule,
+    ):
+        integration = await async_get_integration(hass, "evohome")
+        assert integration.pkg_path == "custom_components.evohome"
+        assert integration.version == "2026.10.0.1"
+        assert await async_setup_component(hass, "evohome", {"evohome": config})
+        await hass.async_block_till_done()
+        states = hass.states.async_all("climate")
+        assert len(states) == 1
+        assert states[0].attributes["temperature"] == 23.0
+        with patch("evohomeasync2.zone.Zone.set_temperature") as set_temperature:
+            await hass.services.async_call(
+                "climate",
+                "set_temperature",
+                {"entity_id": states[0].entity_id, "temperature": 20.5},
+                blocking=True,
+            )
+            set_temperature.assert_awaited_once_with(20.5, until=None)
+        with patch("evohomeasync2.control_system.ControlSystem.set_mode") as set_mode:
+            await hass.services.async_call(
+                "climate", "turn_on", {"entity_id": states[0].entity_id}, blocking=True
+            )
+            set_mode.assert_awaited_once_with("heat", until=None)
+        get_schedule.assert_not_awaited()
