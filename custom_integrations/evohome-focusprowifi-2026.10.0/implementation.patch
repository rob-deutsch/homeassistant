+class EvoFocusProWifi(EvoController):
+    """Combine mode and temperature controls for a schedule-free FocusPro."""
+
+    _attr_icon = "mdi:thermostat"
+
+    def __init__(
+        self, coordinator: EvoDataUpdateCoordinator, evo_device: evo.ControlSystem
+    ) -> None:
+        """Keep the controller identity used by the original FocusPro integration."""
+        super().__init__(coordinator, evo_device)
+        self._zone = evo_device.zones[0]
+        self._attr_supported_features = (
+            ClimateEntityFeature.TARGET_TEMPERATURE
+            | ClimateEntityFeature.TURN_OFF
+            | ClimateEntityFeature.TURN_ON
+        )
+        self._attr_hvac_modes = [
+            mode
+            for mode, evo_mode in (
+                (HVACMode.OFF, EvoSystemMode.OFF),
+                (HVACMode.HEAT, EvoSystemMode.HEAT),
+            )
+            if evo_mode in self._evo_modes
+        ]
+        self._attr_precision = self._zone.setpoint_capabilities["value_resolution"]
+        self._attr_target_temperature_step = self._attr_precision
+        self._attr_min_temp = self._zone.min_heat_setpoint
+        self._attr_max_temp = self._zone.max_heat_setpoint
+
+    @property
+    @override
+    def hvac_mode(self) -> HVACMode | None:
+        """Return the actual controller mode, independently of its setpoint."""
+        return {
+            EvoSystemMode.OFF: HVACMode.OFF,
+            EvoSystemMode.HEAT: HVACMode.HEAT,
+        }.get(self._evo_device.mode)
+
+    @property
+    @override
+    def current_temperature(self) -> float | None:
+        """Return the measured zone temperature when available."""
+        if self._zone.temperature is None:
+            return None
+        if (temperature := self.coordinator.temps.get(self._zone.id)) is not None:
+            return temperature
+        return self._zone.temperature
+
+    @property
+    @override
+    def target_temperature(self) -> float | None:
+        """Return the zone's heating setpoint."""
+        return self._zone.target_heat_temperature
+
+    @property
+    @override
+    def extra_state_attributes(self) -> dict[str, Any]:
+        """Expose controller and zone status together."""
+        status = dict(super().extra_state_attributes["status"])
+        status.update(
+            _recurse_and_revert(
+                {
+                    "zone_id": self._zone.id,
+                    "setpoint_status": self._zone.setpoint_status,
+                    "temperature_status": self._zone.temperature_status,
+                    "zone_active_faults": self._zone.active_faults,
+                }
+            )
+        )
+        return {"status": status}
+
+    @override
+    async def async_set_temperature(self, **kwargs: Any) -> None:
+        """Set a permanent temperature hold without requesting a schedule."""
+        await self.coordinator.call_client_api(
+            self._zone.set_temperature(kwargs[ATTR_TEMPERATURE], until=None)
+        )
+
+    @override
+    async def async_set_zone_override(
+        self, setpoint: float, duration: timedelta | None = None
+    ) -> None:
+        """Allow permanent holds and reject unsupported timed overrides."""
+        if duration is not None:
+            raise ServiceValidationError(
+                "This FocusPro thermostat does not support temporary overrides"
+            )
+        await self.async_set_temperature(
+            temperature=max(min(setpoint, self.max_temp), self.min_temp)
+        )
+
+    @override
+    async def async_clear_zone_override(self) -> None:
+        """Reject clearing a hold when there is no schedule to resume."""
+        raise ServiceValidationError(
+            "This FocusPro thermostat does not support following a schedule"
+        )
