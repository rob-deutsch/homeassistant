diff --git a/tests/components/evohome/test_focusprowifi.py b/tests/components/evohome/test_focusprowifi.py
new file mode 100644
--- /dev/null
+++ b/tests/components/evohome/test_focusprowifi.py
@@ -0,0 +1,209 @@
+"""Test the schedule-free FocusProWifi thermostat from core PR #94805."""
+
+from unittest.mock import patch
+
+import pytest
+
+from homeassistant.components.climate import ClimateEntityFeature, HVACMode
+from homeassistant.components.evohome.const import EVOHOME_DATA
+from homeassistant.core import HomeAssistant
+from homeassistant.exceptions import ServiceValidationError
+from homeassistant.helpers import entity_registry as er
+from homeassistant.helpers.update_coordinator import UpdateFailed
+
+from .conftest import setup_evohome, user_locations_config_fixture
+
+
+async def test_focusprowifi_setup(
+    hass: HomeAssistant, config: dict[str, str], entity_registry: er.EntityRegistry
+) -> None:
+    """Keep one climate entity and never fetch unsupported schedules."""
+    with patch("evohomeasync2.zone.Zone.get_schedule") as get_schedule:
+        async for _ in setup_evohome(hass, config, install="focusprowifi"):
+            states = hass.states.async_all("climate")
+            assert len(states) == 1
+            state = states[0]
+            assert state.state == HVACMode.OFF
+            assert state.attributes["temperature"] == 23.0
+            assert state.attributes["current_temperature"] == 23.0
+            assert state.attributes["min_temp"] == 4.5
+            assert state.attributes["max_temp"] == 32.0
+            assert state.attributes["target_temp_step"] == 0.5
+            assert state.attributes["hvac_modes"] == [HVACMode.OFF, HVACMode.HEAT]
+            assert state.attributes["supported_features"] == (
+                ClimateEntityFeature.TARGET_TEMPERATURE
+                | ClimateEntityFeature.TURN_OFF
+                | ClimateEntityFeature.TURN_ON
+            )
+            await hass.data[EVOHOME_DATA].coordinator.async_refresh()
+            get_schedule.assert_not_awaited()
+            assert not hass.states.async_all("button")
+            assert entity_registry.async_get(state.entity_id).unique_id == "416856"
+
+
+@pytest.mark.parametrize(
+    ("service", "data", "mode"),
+    [
+        ("set_hvac_mode", {"hvac_mode": "heat"}, "heat"),
+        ("set_hvac_mode", {"hvac_mode": "off"}, "off"),
+        ("turn_on", {}, "heat"),
+        ("turn_off", {}, "off"),
+    ],
+)
+async def test_focusprowifi_mode_controls(
+    hass: HomeAssistant,
+    config: dict[str, str],
+    service: str,
+    data: dict[str, str],
+    mode: str,
+) -> None:
+    """Modern climate actions control the system, never a frost setpoint."""
+    async for _ in setup_evohome(hass, config, install="focusprowifi"):
+        entity = hass.states.async_all("climate")[0]
+        with (
+            patch("evohomeasync2.control_system.ControlSystem.set_mode") as set_mode,
+            patch("evohomeasync2.zone.Zone.set_temperature") as set_temperature,
+        ):
+            await hass.services.async_call(
+                "climate",
+                service,
+                {"entity_id": entity.entity_id, **data},
+                blocking=True,
+            )
+            set_mode.assert_awaited_once_with(mode, until=None)
+            set_temperature.assert_not_awaited()
+
+
+@pytest.mark.parametrize(
+    ("domain", "service", "data"),
+    [
+        ("climate", "set_temperature", {"temperature": 20.5}),
+        ("evohome", "set_zone_override", {"setpoint": 20.5}),
+    ],
+)
+async def test_focusprowifi_permanent_hold(
+    hass: HomeAssistant,
+    config: dict[str, str],
+    domain: str,
+    service: str,
+    data: dict[str, float],
+) -> None:
+    """Both temperature actions send permanent holds without schedule calls."""
+    with patch("evohomeasync2.zone.Zone.get_schedule") as get_schedule:
+        async for _ in setup_evohome(hass, config, install="focusprowifi"):
+            entity = hass.states.async_all("climate")[0]
+            with patch("evohomeasync2.zone.Zone.set_temperature") as set_temperature:
+                await hass.services.async_call(
+                    domain,
+                    service,
+                    {"entity_id": entity.entity_id, **data},
+                    blocking=True,
+                )
+                set_temperature.assert_awaited_once_with(20.5, until=None)
+            get_schedule.assert_not_awaited()
+
+
+@pytest.mark.parametrize("mode", ["Heat", "Off"])
+async def test_focusprowifi_system_service(
+    hass: HomeAssistant, config: dict[str, str], mode: str
+) -> None:
+    """The combined entity handles the integration's controller service."""
+    async for _ in setup_evohome(hass, config, install="focusprowifi"):
+        entity = hass.states.async_all("climate")[0]
+        with patch("evohomeasync2.control_system.ControlSystem.set_mode") as set_mode:
+            await hass.services.async_call(
+                "evohome",
+                "set_system_mode",
+                {"entity_id": entity.entity_id, "mode": mode},
+                blocking=True,
+            )
+            await hass.async_block_till_done()
+            set_mode.assert_awaited_once_with(mode.lower(), until=None)
+
+
+@pytest.mark.parametrize(
+    ("service", "data", "message"),
+    [
+        ("set_zone_override", {"setpoint": 20, "duration": 0}, "temporary overrides"),
+        ("set_zone_override", {"setpoint": 20, "duration": 60}, "temporary overrides"),
+        ("clear_zone_override", {}, "following a schedule"),
+    ],
+)
+async def test_focusprowifi_rejects_schedule_actions(
+    hass: HomeAssistant,
+    config: dict[str, str],
+    service: str,
+    data: dict[str, int],
+    message: str,
+) -> None:
+    """Unsupported schedule actions fail before issuing a vendor request."""
+    async for _ in setup_evohome(hass, config, install="focusprowifi"):
+        entity = hass.states.async_all("climate")[0]
+        with (
+            patch("evohomeasync2.zone.Zone.set_temperature") as set_temperature,
+            patch("evohomeasync2.zone.Zone.reset") as reset,
+            pytest.raises(ServiceValidationError, match=message),
+        ):
+            await hass.services.async_call(
+                "evohome",
+                service,
+                {"entity_id": entity.entity_id, **data},
+                blocking=True,
+            )
+        set_temperature.assert_not_awaited()
+        reset.assert_not_awaited()
+
+
+async def test_focusprowifi_state_refresh(
+    hass: HomeAssistant, config: dict[str, str]
+) -> None:
+    """Cloud status drives mode, temperatures, and unavailable measurements."""
+    async for _ in setup_evohome(hass, config, install="focusprowifi"):
+        coordinator = hass.data[EVOHOME_DATA].coordinator
+        entity = hass.states.async_all("climate")[0]
+        tcs = coordinator.tcs
+        zone = tcs.zones[0]
+        tcs.status["system_mode_status"]["mode"] = "heat"
+        zone.status["temperature_status"]["temperature"] = 21.5
+        zone.status["setpoint_status"]["target_heat_temperature"] = 20.5
+        coordinator.async_set_updated_data(coordinator.data)
+        state = hass.states.get(entity.entity_id)
+        assert state.state == HVACMode.HEAT
+        assert state.attributes["temperature"] == 20.5
+        assert state.attributes["current_temperature"] == 21.5
+        assert (
+            state.attributes["status"]["setpoint_status"]["target_heat_temperature"]
+            == 20.5
+        )
+
+        zone.status["temperature_status"]["is_available"] = False
+        coordinator.temps[zone.id] = 21.5
+        coordinator.async_set_updated_data(coordinator.data)
+        assert (
+            hass.states.get(entity.entity_id).attributes["current_temperature"] is None
+        )
+        coordinator.async_set_update_error(UpdateFailed("Cloud unavailable"))
+        assert hass.states.get(entity.entity_id).state == "unavailable"
+
+
+@pytest.mark.parametrize("available_modes", [["Off"], ["Off", "Heat"]])
+async def test_focusprowifi_supported_modes(
+    hass: HomeAssistant, config: dict[str, str], available_modes: list[str]
+) -> None:
+    """Advertise only HVAC modes actually supported by this thermostat."""
+    locations = user_locations_config_fixture("focusprowifi")
+    tcs = locations[0]["gateways"][0]["temperatureControlSystems"][0]
+    tcs["allowedSystemModes"] = [
+        mode
+        for mode in tcs["allowedSystemModes"]
+        if mode["systemMode"] in available_modes
+    ]
+    with patch(
+        "tests.components.evohome.conftest.user_locations_config_fixture",
+        return_value=locations,
+    ):
+        async for _ in setup_evohome(hass, config, install="focusprowifi"):
+            entity = hass.states.async_all("climate")[0]
+            assert entity.attributes["hvac_modes"] == [
+                mode.lower() for mode in available_modes
+            ]
